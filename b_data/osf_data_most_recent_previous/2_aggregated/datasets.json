  ],
  "aspects": {
    "physical_climate": {
      "description": "Direct physical climate impacts",
      "sub_aspects": ["temperature", "precipitation", "uv_radiation", "sea_ice", "solar_radiation"]
    },
    "biological_impacts": {
      "description": "Impacts on biological systems and ecosystems",
      "sub_aspects": ["agriculture", "fisheries"]
    },
    "human_consequences": {
      "description": "Direct impacts on human populations and systems",
      "sub_aspects": ["food_security", "migration", "trade"]
    }
  },
  "scenarios": {
    "5Tg": "5 Tg soot injection scenario",
    "16Tg": "16 Tg soot injection scenario (India-Pakistan regional war)",
    "27Tg": "27 Tg soot injection scenario",
    "47Tg": "47 Tg soot injection scenario",
    "150Tg": "150 Tg soot injection scenario (US-Russia full-scale war)",
    "control": "Control scenario (no nuclear conflict)"
  }
}
