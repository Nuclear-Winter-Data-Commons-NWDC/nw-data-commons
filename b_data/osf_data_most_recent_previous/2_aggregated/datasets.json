{
  "metadata": {
    "schema_version": "1.0",
    "last_updated": "2026-02-12",
    "description": "Registry of all aggregated datasets in the Nuclear Winter Data Commons",
    "naming_convention": "Simple theme-based names. Add distinguishing suffixes (model, version, etc.) only when multiple datasets exist for same theme."
  },
  "datasets": [
    {
      "id": "temperature",
      "display_name": "Temperature",
      "aspect": "physical_climate",
      "sub_aspect": "temperature",
      "model": "CESM",
      "contributor": "Harrison",
      "variables": [
        "surface.temp",
        "surface.temp.stdev"
      ],
      "unit_of_analysis": "country",
      "format": "xlsx",
      "scenarios": ["5Tg", "16Tg", "27Tg", "47Tg", "150Tg"],
      "date_added": "2024-09-01",
      "local_path": "b_data/3_aggregated/temperature/",
      "osf_path": "/3_aggregated/temperature/",
      "status": "active",
      "supersedes": null,
      "notes": "Surface temperature mean and standard deviation by country."
    },
    {
